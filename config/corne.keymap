#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hrml: home-row-mod-left {
            compatible = "zmk,behavior-hold-tap";
            label = "home-row-mod-left";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <39 30 18 6 7 19 31 40 41 32 20 8 9 21 22 23 33 34 35 10 11>;
        };

        hrmr: home-row-mod-right {
            compatible = "zmk,behavior-hold-tap";
            label = "home-row-mod-right";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 3>;
            hold-trigger-on-release;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB     &kp Q             &kp W             &kp E                 &kp R               &kp T        &kp Y          &kp U                &kp I                  &kp O              &kp P                 &kp ENTER
&kp ESCAPE  &hrml LEFT_GUI A  &hrml LEFT_ALT S  &hrml LEFT_CONTROL D  &hrml LEFT_SHIFT F  &kp G        &kp H          &hrmr RIGHT_SHIFT J  &hrmr RIGHT_CONTROL K  &hrmr RIGHT_ALT L  &hrmr RIGHT_GUI SEMI  &kp APOS
&kp LSHIFT  &kp Z             &kp X             &kp C                 &kp V               &kp B        &kp N          &kp M                &kp COMMA              &kp DOT            &kp FSLH              &kp RSHIFT
                                                &kp CAPSLOCK          &mo 2               &kp SPACE    &kp BACKSPACE  &mo 1                &kp K_CMENU
            >;
        };

        lower_layer {
            display-name = "Lower Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans                  &trans                  &trans                 &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT  &hrmr RIGHT_SHIFT DOWN  &hrmr RIGHT_CONTROL UP  &hrmr RIGHT_ALT RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp HOME  &kp PAGE_DOWN           &kp PAGE_UP             &kp END                &trans  &trans
                        &trans  &mo 3   &trans    &trans    &trans                  &trans
            >;
        };

        raise_layer {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp NUMBER_1          &kp NUMBER_2          &kp NUMBER_3              &kp NUMBER_4  &kp N5    &kp NUMBER_6  &kp N7  &kp N8                         &kp N9                        &kp N0                         &trans
&trans  &hrml LEFT_GUI GRAVE  &hrml LEFT_ALT EQUAL  &hrml LEFT_CONTROL MINUS  &trans        &trans    &trans        &trans  &hrmr RIGHT_CONTROL BACKSLASH  &hrmr RIGHT_ALT LEFT_BRACKET  &hrmr RIGHT_GUI RIGHT_BRACKET  &trans
&trans  &trans                &trans                &trans                    &trans        &trans    &trans        &trans  &trans                         &trans                        &trans                         &trans
                                                    &trans                    &trans        &trans    &kp DELETE    &mo 3   &trans
            >;
        };

        function_layer {
            bindings = <
&kp F12     &kp F1        &kp F2        &kp F3              &kp F4                   &kp F5          &kp F6      &kp F7                           &kp F8                        &kp F9                  &kp F10                       &kp F11
&trans      &trans        &trans        &hrml LCTRL INSERT  &hrml LSHFT PRINTSCREEN  &trans          &kp C_PREV  &hrmr RIGHT_SHIFT C_VOLUME_DOWN  &hrmr RIGHT_CONTROL C_VOL_UP  &hrmr RIGHT_ALT C_NEXT  &hrmr RIGHT_GUI C_PLAY_PAUSE  &kp C_MUTE
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2        &bt BT_SEL 3             &bt BT_SEL 4    &trans      &trans                           &trans                        &trans                  &trans                        &trans
                                        &trans              &trans                   &trans          &trans      &trans                           &trans
            >;

            label = "Function Layer";
        };
    };
};
